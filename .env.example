# ==============================================================
# GOO-TRANDING: Environment Configuration Example
# ==============================================================

# 1. Gemini AI API Key (Required for on-demand deep-dive & AI intelligence generation)
# In AI Studio, this is automatically injected at runtime.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# 2. Server Configuration
PORT=3000
NODE_ENV=production
APP_URL="https://goo-tranding.com"

# 3. Automation & Cron Security
# Protects /api/internal/* endpoints from unauthorized triggers
CRON_SECRET="your_secure_cron_token_here"

# 4. Cloudflare D1 & KV Credentials (If deploying to Cloudflare Workers)
CLOUDFLARE_ACCOUNT_ID="your_cloudflare_account_id"
CLOUDFLARE_D1_DATABASE_ID="d1-goo-tranding-production-id"
CLOUDFLARE_KV_NAMESPACE_ID="kv-goo-tranding-cache-id"

# 5. Multi-Channel Distribution Tokens (Optional for automated outbound dispatches)
TELEGRAM_BOT_TOKEN="your_telegram_bot_token"
TELEGRAM_CHANNEL_ID="@GooTrendingGlobal"
WHATSAPP_API_TOKEN="your_whatsapp_cloud_api_token"
RESEND_API_KEY="your_resend_email_api_key"
